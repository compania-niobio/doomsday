		head: ['Mas o fim', 'não começou agora.'],
		body: ['Cada batalha, cada escolha e cada sacrifício nos trouxeram até aqui.'],
		finale: 'Tudo está conectado.',
	},
];

const acts = actsRaw.map((act, i) => {
	let w = 0;
	const lines = act.head.map((line) => line.split(' ').map((t) => ({ t, w: w++ })));
	const align = i === actsRaw.length - 1 ? 'center' : i % 2 ? 'right' : 'left';
	// Fecho agrupado por palavra: a quebra de linha só acontece entre palavras
	let k = 0;
	const finaleWords = act.finale
		? act.finale.split(' ').map((word) => [...word].map((ch) => ({ ch, i: k++ })))
		: null;
	return { ...act, lines, align, finaleWords };
});

