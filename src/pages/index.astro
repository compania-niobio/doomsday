<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const story = document.querySelector<HTMLElement>('[data-story]');
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const track = document.querySelector<HTMLElement>('[data-acts]');
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
	const timecode = document.querySelector<HTMLElement>('[data-timecode]');
	const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

	if (story && hero && track && video) {
		// 1 · Abertura: espera o vídeo (máx. 1.4s) e abre a fenda cinemascope
		let opened = false;
		const open = () => {
			if (opened) return;
			opened = true;
			// setTimeout (não rAF): abas em segundo plano não disparam rAF e a fenda ficaria fechada
			window.setTimeout(() => hero.classList.add('is-ready'), 60);
			// o Ato 01 começa a surgir enquanto a fenda termina de abrir
			window.setTimeout(startReveal, reduce ? 0 : 900);
		};
		if (video.readyState >= 2) open();
		video.addEventListener('loadeddata', open, { once: true });
		window.setTimeout(open, 1400);

		// iOS/Safari só pinta quadros de um vídeo que já foi "tocado" uma vez
		video.play().then(() => video.pause()).catch(() => {});

		// 2 · Atos: revelação ao entrar
		const items = [...track.querySelectorAll<HTMLElement>('[data-act]')];

		function startReveal() {
			if (reduce) {
				items.forEach((el) => el.classList.add('is-in'));
				return;
			}
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((e) => {
						if (!e.isIntersecting) return;
						e.target.classList.add('is-in');
						io.unobserve(e.target);
					}),
				{ rootMargin: '0px 0px -30% 0px' },
			);
			items.forEach((el) => io.observe(el));
		}

		// 3 · Rolagem → progresso da história (--sp), saída da primeira tela (--intro) e parallax dos atos (--p)
		let progress = 0;
		const update = () => {
			const vh = window.innerHeight;
			const sr = story.getBoundingClientRect();
			progress = clamp(-sr.top / (sr.height - vh), 0, 1);
			const intro = clamp(-sr.top / (vh * 0.6), 0, 1);

			let active = 0;
			let nearest = Infinity;
			items.forEach((el, i) => {
				const r = el.getBoundingClientRect();
				const p = (r.top + r.height / 2 - vh / 2) / vh;
				const d = Math.abs(p);
				if (!reduce) {
					el.style.setProperty('--p', clamp(p, -1.5, 1.5).toFixed(3));
					el.style.setProperty('--o', clamp(1.25 - d * 1.1, 0, 1).toFixed(3));
				}
				if (d < nearest) {
					nearest = d;
					active = i;
				}
			});

			story.style.setProperty('--sp', progress.toFixed(4));
			story.style.setProperty('--intro', intro.toFixed(3));
			story.style.setProperty('--gx', active === items.length - 1 ? '50%' : active % 2 ? '72%' : '28%');
			hero.classList.toggle('is-past-intro', intro > 0.5);
		};

		let pending = false;
		const schedule = () => {
			if (pending) return;
			pending = true;
			requestAnimationFrame(() => {
				update();
				pending = false;
			});
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();

		// 4 · Vídeo controlado pela rolagem (scrub) com suavização — só busca um quadro novo quando o anterior terminou
		const fmt = (t: number) => {
			const m = Math.floor(t / 60).toString().padStart(2, '0');
			const s = (t % 60).toFixed(1).padStart(4, '0');
			return `${m}:${s}`;
		};
		let shown = 0;
		const scrub = () => {
			const dur = video.duration;
			if (dur && !reduce) {
				const target = progress * (dur - 0.05);
				shown += (target - shown) * 0.14;
				if (Math.abs(target - shown) < 0.002) shown = target;
				if (!video.seeking && Math.abs(video.currentTime - shown) > 0.01) {
					video.currentTime = shown;
				}
			}
			if (dur && timecode) timecode.textContent = fmt(video.currentTime);
			requestAnimationFrame(scrub);
		};
		requestAnimationFrame(scrub);
	}

	// 6 · Segunda dobra — Linha do Tempo Sagrada (câmera guiada pela rolagem ao longo do fio)
	const saga = document.querySelector<HTMLElement>('[data-saga]');
	if (saga) {
		const films = [...saga.querySelectorAll<HTMLElement>('[data-film]')];
		const bgs = [...saga.querySelectorAll<HTMLElement>('[data-film-bg]')];
		const stage = saga.querySelector<HTMLElement>('[data-sg-stage]');
		const track = saga.querySelector<HTMLElement>('[data-sg-track]');
		const copy = saga.querySelector<HTMLElement>('[data-saga-copy]');
		const titleEl = saga.querySelector<HTMLElement>('[data-saga-title]');
		const synopsis = saga.querySelector<HTMLElement>('[data-saga-synopsis]');
		const chapter = saga.querySelector<HTMLElement>('[data-saga-chapter]');
		const tHud = saga.querySelector<HTMLElement>('[data-sg-t]');
		const prunedHud = saga.querySelector<HTMLElement>('[data-sg-pruned]');
		const mobile = window.matchMedia('(max-width: 900px)');
		const total = films.length;
		const nodeX = films.map((f) => Number(f.dataset.x));
		const years = films.map((f) => Number(f.dataset.year));
		const branches = [...saga.querySelectorAll<SVGGElement>('[data-bx]')].map((g) => ({
			g,
			x: Number(g.dataset.bx),
			paths: [...g.querySelectorAll<SVGPathElement>('path')],
			grown: -1,
			pruned: false,
		}));
		const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
		const ease = (t: number) => t * t * (3 - 2 * t);
		let index = -1;
		let inView = false;

		// Título: nome do filme, letra por letra (textSlide)
		const renderTitle = (title: string, year: string) => {
			if (!titleEl) return;
			let n = 0;
			const line = (text: string, kind: string) => {
				const el = document.createElement('span');
				el.className = `t-line t-line--${kind}`;
				el.setAttribute('aria-hidden', 'true');
				text.split(' ').forEach((word, wi, arr) => {
					const w = document.createElement('span');
					w.className = 't-word';
					[...word].forEach((ch) => {
						const c = document.createElement('span');
						c.className = 't-ch';
						c.style.setProperty('--i', String(n++));
						c.textContent = ch;
						w.appendChild(c);
					});
					el.appendChild(w);
					if (wi < arr.length - 1) el.appendChild(document.createTextNode(' '));
				});
				return el;
			};
			// Só o nome: o ano aparece no fio (ano-fantasma ao lado do nó)
			titleEl.replaceChildren(line(title, 'fill'));
			titleEl.classList.toggle('is-long', title.length > 18);
			titleEl.setAttribute('aria-label', `${title} (${year})`);
		};

		const go = (i: number) => {
			if (i === index) return;
			const first = index === -1;
			index = i;

			films.forEach((el, k) => {
				el.classList.toggle('is-active', k === i);
				el.querySelector('.sg-card')?.setAttribute('aria-current', k === i ? 'true' : 'false');
			});
			bgs.forEach((el, k) => el.classList.toggle('is-active', k === i));

			const d = films[i].dataset;

			const apply = () => {
				renderTitle(d.title ?? '', d.year ?? '');
				if (synopsis) {
					synopsis.textContent = d.synopsis ?? '';
					synopsis.hidden = !d.synopsis;
				}
				if (chapter) chapter.textContent = `Capítulo ${d.n}`;
				copy?.classList.remove('is-swapping');
			};
			if (first || reduce) apply();
			else {
				copy?.classList.add('is-swapping');
				window.setTimeout(apply, 320);
			}
		};

		// Progresso da rolagem → posição da câmera no fio (unidades do mundo).
		// A câmera "repousa" em cada nó por um trecho e viaja entre eles com easing.
		const LEAD = 700;
		const progressOf = () => {
			const r = saga.getBoundingClientRect();
			return clamp01(-r.top / (r.height - window.innerHeight));
		};
		const frame = () => {
			const p = progressOf();
			saga.style.setProperty('--k', p.toFixed(4));

			const u = p * total - 0.5;
			let cam: number;
			let year: number;
			if (u <= 0) {
				cam = nodeX[0] + u * LEAD;
				year = years[0];
			} else if (u >= total - 1) {
				cam = nodeX[total - 1] + (u - (total - 1)) * LEAD;
				year = years[total - 1];
			} else {
				const b = Math.floor(u);
				const e = ease(clamp01((u - b - 0.2) / 0.6));
				cam = nodeX[b] + (nodeX[b + 1] - nodeX[b]) * e;
				year = years[b] + (years[b + 1] - years[b]) * e;
			}
			go(Math.min(total - 1, Math.max(0, Math.round(u))));

			if (stage && track) {
				const s = stage.clientHeight / 1000;
				const focus = stage.clientWidth * (mobile.matches ? 0.5 : 0.62);
				track.style.setProperty('--tx', `${(focus - cam * s).toFixed(1)}px`);
			}

			// Variantes: crescem à frente da câmera, são podadas depois que ela passa
			let pruned = 0;
			branches.forEach((b) => {
				const d = cam - b.x;
				const g = reduce ? 1 : Math.round(clamp01((d + 720) / 540) * 200) / 200;
				if (g !== b.grown) {
					b.grown = g;
					b.paths.forEach((path, k) => {
						const gk = k === 0 ? g : clamp01(g * 1.8 - 0.8);
						path.style.strokeDashoffset = String(1 - gk);
					});
				}
				const isPruned = d > 420;
				if (isPruned) pruned++;
				if (isPruned !== b.pruned) {
					b.pruned = isPruned;
					b.g.classList.toggle('is-pruned', isPruned);
				}
			});

			if (tHud) tHud.textContent = year.toFixed(1);
			if (prunedHud) prunedHud.textContent = String(pruned).padStart(3, '0');
		};

		let ticking = false;
		const schedule = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				frame();
				ticking = false;
			});
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);

		// Nó, pôster e teclado rolam até o trecho do filme
		const scrollToFilm = (target: number) => {
			const i = Math.min(total - 1, Math.max(0, target));
			const top = saga.getBoundingClientRect().top + window.scrollY;
			const span = saga.offsetHeight - window.innerHeight;
			window.scrollTo({ top: top + span * ((i + 0.5) / total), behavior: reduce ? 'auto' : 'smooth' });
		};
		films.forEach((el, k) =>
			el.querySelectorAll('.sg-card, .sg-node').forEach((b) => b.addEventListener('click', () => scrollToFilm(k))),
		);

		window.addEventListener('keydown', (e) => {
			if (!inView) return;
			const t = e.target as HTMLElement | null;
			if (t && /INPUT|TEXTAREA|SELECT/.test(t.tagName)) return;
			if (e.key === 'ArrowRight') scrollToFilm(index + 1);
			if (e.key === 'ArrowLeft') scrollToFilm(index - 1);
		});

		const card = saga.querySelector<HTMLElement>('[data-saga-card]');
		new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				if (inView) saga.classList.add('is-in');
			},
			{ threshold: 0.3 },
		).observe(card ?? saga);

		// Tilt no pôster ativo (±8°) + parallax do fundo pelo cursor — só ponteiro fino
		if (!reduce && window.matchMedia('(pointer: fine)').matches) {
			saga.querySelectorAll<HTMLElement>('[data-tilt-poster]').forEach((poster) => {
				poster.addEventListener('mousemove', (e) => {
					if (!poster.closest('.is-active')) return;
					const r = poster.getBoundingClientRect();
					const x = (e.clientX - r.left) / r.width - 0.5;
					const y = (e.clientY - r.top) / r.height - 0.5;
					poster.style.transform = `rotateY(${x * 16}deg) rotateX(${y * -16}deg)`;
				});
				poster.addEventListener('mouseleave', () => (poster.style.transform = ''));
			});

			saga.addEventListener('mousemove', (e) => {
				const r = saga.getBoundingClientRect();
				saga.style.setProperty('--bx', `${((e.clientX - r.left) / r.width - 0.5) * -24}px`);
				saga.style.setProperty('--by', `${((e.clientY - r.top) / r.height - 0.5) * -16}px`);
			});
		}

		frame();
	}
	// 7 · Terceira dobra — A Convergência (fios → singularidade → fenda → trailer)
	const doom = document.querySelector<HTMLElement>('[data-doom]');
	if (doom) {
		const videoId = doom.dataset.video ?? '';
		const screen = doom.querySelector<HTMLElement>('[data-doom-screen]');
		const rift = doom.querySelector<HTMLElement>('[data-doom-rift]');
		const media = doom.querySelector<HTMLElement>('[data-doom-media]');
		const thumb = doom.querySelector<HTMLImageElement>('[data-doom-thumb]');
		const playBtn = doom.querySelector<HTMLButtonElement>('[data-doom-play]');
		const status = doom.querySelector<HTMLElement>('[data-doom-status]');
		const rayLines = [...doom.querySelectorAll<SVGPathElement>('[data-doom-ray]')];
		const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
		const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
		let playing = false;
		let rifted = false;

		// maxresdefault nem sempre existe: o YouTube devolve uma miniatura cinza de 120 px
		if (thumb) {
			const fallback = () => {
				if (!thumb.src.includes('hqdefault')) thumb.src = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
			};
			thumb.addEventListener('error', fallback);
			thumb.addEventListener('load', () => thumb.naturalWidth <= 120 && fallback());
		}

		const frame = () => {
			const r = doom.getBoundingClientRect();
			const p = reduce ? 1 : clamp01(-r.top / (r.height - window.innerHeight));
			const draw = ease(clamp01(p / 0.3));
			const c = ease(clamp01((p - 0.22) / 0.28));
			const o = playing || reduce ? 1 : clamp01((p - 0.48) / 0.32);
			doom.style.setProperty('--draw', draw.toFixed(3));
			doom.style.setProperty('--c', c.toFixed(3));
			doom.style.setProperty('--o', o.toFixed(3));

			// Fios se desenham da borda até o centro, levemente defasados
			rayLines.forEach((ray, i) => {
				ray.style.strokeDashoffset = String(1 - clamp01(draw * 1.3 - (i % 5) * 0.07));
			});

			// A fenda: primeiro uma linha horizontal de luz, depois abre na vertical
			if (screen && rift) {
				const W = screen.offsetWidth;
				const H = screen.offsetHeight;
				const sw = ease(clamp01(o / 0.45));
				const sh = ease(clamp01((o - 0.3) / 0.7));
				const w = 10 + (W - 10) * sw;
				const h = 3 + (H - 3) * sh;
				const rad = (1 - sh) * (Math.min(w, h) / 2) + sh * 18;
				if (o <= 0) screen.style.clipPath = 'inset(50% 50% round 999px)';
				else if (o >= 1) screen.style.clipPath = 'none';
				else screen.style.clipPath = `inset(${((H - h) / 2).toFixed(1)}px ${((W - w) / 2).toFixed(1)}px round ${rad.toFixed(1)}px)`;
				rift.style.setProperty('--rw', `${w.toFixed(1)}px`);
				rift.style.setProperty('--rh', `${h.toFixed(1)}px`);
				rift.style.setProperty('--rr', `${rad.toFixed(1)}px`);
			}

			// Tremor uma vez, no instante em que a fenda rasga
			if (o > 0.01 && !rifted && !reduce) {
				rifted = true;
				doom.classList.add('is-rift');
				window.setTimeout(() => doom.classList.remove('is-rift'), 600);
			}
			if (o <= 0.01) rifted = false;

			const isOpen = o >= 0.98;
			doom.classList.toggle('is-open', isOpen);
			if (status && !playing) status.textContent = isOpen ? 'Sinal estável' : 'Sinal interceptado';
		};

		// Play: só agora o player do YouTube é carregado (sem cookies)
		const play = () => {
			if (playing || !media) return;
			playing = true;
			doom.classList.add('is-playing');
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1`;
			iframe.title = 'Trailer — Vingadores: Doomsday';
			iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			iframe.allowFullscreen = true;
			media.replaceChildren(iframe);
			if (status) status.textContent = 'Reproduzindo';
			frame();
		};
		playBtn?.addEventListener('click', play);

		let ticking = false;
		const schedule = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				frame();
				ticking = false;
			});
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);

		new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting) doom.classList.add('is-in');
			},
			{ threshold: 0.3 },
		).observe(doom.querySelector('[data-doom-card]') ?? doom);

		frame();
	}

	// 8 · Quarta dobra — marquee do vídeo: um só vídeo toca (mudo, em loop) e cada cópia recebe o quadro atual
	const finalVideoEl = document.querySelector<HTMLVideoElement>('[data-final-video]');
	const finalTiles = [...document.querySelectorAll<HTMLCanvasElement>('[data-final-tile]')]
		.map((c) => c.getContext('2d'))
		.filter((ctx): ctx is CanvasRenderingContext2D => !!ctx);
	if (finalVideoEl && finalTiles.length) {
		const paint = () => {
			if (finalVideoEl.readyState < 2) return;
			finalTiles.forEach((ctx) => ctx.drawImage(finalVideoEl, 0, 0, ctx.canvas.width, ctx.canvas.height));
		};
		let visible = false;
		let raf = 0;
		const loop = () => {
			paint();
			raf = visible ? requestAnimationFrame(loop) : 0;
		};
		finalVideoEl.addEventListener('loadeddata', paint);
		finalVideoEl.addEventListener('seeked', paint);

		// Toca enquanto qualquer uma das faixas estiver na tela
		const marquees = [...document.querySelectorAll<HTMLElement>('[data-final-marquee]')];
		const onScreen = new Set<Element>();
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => (entry.isIntersecting ? onScreen.add(entry.target) : onScreen.delete(entry.target)));
				visible = onScreen.size > 0;
				if (reduce) {
					paint();
					return;
				}
				if (visible) {
					finalVideoEl.play().catch(() => {});
					if (!raf) raf = requestAnimationFrame(loop);
				} else {
					finalVideoEl.pause();
				}
			},
			{ threshold: 0.05 },
		);
		marquees.forEach((m) => observer.observe(m));
	}

	// 9 · Estreia — contagem regressiva até 16/12/2026 + salvar a data no calendário (.ics)
	const release = document.querySelector<HTMLElement>('[data-release]');
	if (release) {
		const target = new Date(release.dataset.target ?? '2026-12-16T00:00:00-03:00').getTime();
		const cells = {
			d: release.querySelector<HTMLElement>('[data-cd="d"]'),
			h: release.querySelector<HTMLElement>('[data-cd="h"]'),
			m: release.querySelector<HTMLElement>('[data-cd="m"]'),
			s: release.querySelector<HTMLElement>('[data-cd="s"]'),
		};
		const countdown = release.querySelector<HTMLElement>('.countdown');
		const done = release.querySelector<HTMLElement>('[data-cd-done]');
		const pad = (n: number) => String(n).padStart(2, '0');

		const set = (el: HTMLElement | null, value: string) => {
			if (!el || el.textContent === value) return;
			el.textContent = value;
			if (reduce) return;
			el.classList.remove('is-tick');
			void el.offsetWidth; // reinicia a animação
			el.classList.add('is-tick');
		};

		let timer = 0;
		const tick = () => {
			const left = Math.max(0, target - Date.now());
			if (left === 0) {
				countdown?.setAttribute('hidden', '');
				if (done) done.hidden = false;
				window.clearInterval(timer);
				return;
			}
			const sec = Math.floor(left / 1000);
			set(cells.d, pad(Math.floor(sec / 86400)));
			set(cells.h, pad(Math.floor((sec % 86400) / 3600)));
			set(cells.m, pad(Math.floor((sec % 3600) / 60)));
			set(cells.s, pad(sec % 60));
		};
		tick();
		timer = window.setInterval(tick, 1000);

		// Arquivo de calendário: evento de dia inteiro + lembrete um dia antes
		const saveBtn = release.querySelector<HTMLButtonElement>('[data-save-date]');
		const saveLabel = release.querySelector<HTMLElement>('[data-save-label]');
		saveBtn?.addEventListener('click', () => {
			const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
			const ics = [
				'BEGIN:VCALENDAR',
				'VERSION:2.0',
				'PRODID:-//Vingadores Doomsday//Site promocional//PT-BR',
				'CALSCALE:GREGORIAN',
				'METHOD:PUBLISH',
				'BEGIN:VEVENT',
				'UID:estreia-vingadores-doomsday-20261216',
				`DTSTAMP:${stamp}`,
				'DTSTART;VALUE=DATE:20261216',
				'DTEND;VALUE=DATE:20261217',
				'SUMMARY:Estreia de Vingadores: Doomsday',
				'DESCRIPTION:Vingadores: Doomsday estreia hoje nos cinemas.',
				'TRANSP:TRANSPARENT',
				'BEGIN:VALARM',
				'TRIGGER:-P1D',
				'ACTION:DISPLAY',
				'DESCRIPTION:Amanhã estreia Vingadores: Doomsday',
				'END:VALARM',
				'END:VEVENT',
				'END:VCALENDAR',
			].join('\r\n');
			const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
			const a = document.createElement('a');
			a.href = url;
			a.download = 'estreia-vingadores-doomsday.ics';
			document.body.appendChild(a);
			a.click();
			a.remove();
			window.setTimeout(() => URL.revokeObjectURL(url), 1000);
			if (saveLabel) {
				const original = saveLabel.textContent;
				saveLabel.textContent = 'Arquivo baixado — abra para salvar no calendário';
				window.setTimeout(() => (saveLabel.textContent = original), 3200);
			}
		});
	}
	// 10 · Ingresso — "A Emissão": aparece depois de marcar o dia (Google Agenda ou .ics)
	const ticket = document.querySelector<HTMLElement>('[data-ticket]');
	const openTicket = (() => {
		if (!ticket) return () => {};
		const stage = ticket.querySelector<HTMLElement>('[data-ticket-stage]');
		const card = ticket.querySelector<HTMLElement>('[data-ticket-card]');
		const stub = ticket.querySelector<HTMLElement>('[data-ticket-stub]');
		const status = ticket.querySelector<HTMLElement>('[data-ticket-status]');
		const flipBtn = ticket.querySelector<HTMLButtonElement>('[data-ticket-flip]');
		const tearBtn = ticket.querySelector<HTMLButtonElement>('[data-ticket-tear]');
		const closeBtn = ticket.querySelector<HTMLButtonElement>('.tk-close');
		const PHASES = ['is-open', 'is-slot', 'is-printing', 'is-printed', 'is-sheen', 'is-scan', 'is-torn', 'is-tilting'];
		let timers: number[] = [];
		let flipped = false;
		let torn = false;
		let lastFocus: HTMLElement | null = null;

		const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
		const setStatus = (text: string) => status && (status.textContent = text);
		const setFlip = (on: boolean) => {
			flipped = on;
			ticket.style.setProperty('--flip', on ? '1' : '0');
			if (flipBtn) flipBtn.textContent = on ? 'Ver a frente' : 'Virar ingresso';
		};

		const open = () => {
			if (!ticket.hidden) return;
			timers.forEach(clearTimeout);
			timers = [];
			ticket.classList.remove(...PHASES);
			ticket.style.removeProperty('--rx');
			ticket.style.removeProperty('--ry');
			torn = false;
			setFlip(false);
			if (flipBtn) flipBtn.disabled = false;
			if (tearBtn) tearBtn.disabled = false;
			setStatus('Emitindo ingresso');
			lastFocus = document.activeElement as HTMLElement | null;
			ticket.hidden = false;
			document.documentElement.style.overflow = 'hidden';
			closeBtn?.focus({ preventScroll: true });

			if (reduce) {
				ticket.classList.add('is-open', 'is-printed');
				setStatus('Ingresso emitido · 16.12.2026');
				return;
			}
			// Linha do tempo da emissão
			requestAnimationFrame(() => ticket.classList.add('is-open'));
			later(350, () => ticket.classList.add('is-slot'));
			later(850, () => ticket.classList.add('is-printing'));
			later(2400, () => {
				ticket.classList.add('is-printed', 'is-sheen');
				setStatus('Ingresso emitido · 16.12.2026');
			});
			later(3700, () => ticket.classList.remove('is-sheen'));
			later(3000, () => ticket.classList.add('is-scan'));
			later(5400, () => !torn && setFlip(true));
			later(7200, () => !torn && setFlip(false));
		};

		const close = () => {
			if (ticket.hidden) return;
			timers.forEach(clearTimeout);
			timers = [];
			ticket.classList.remove('is-open');
			window.setTimeout(() => {
				ticket.hidden = true;
				ticket.classList.remove(...PHASES);
				document.documentElement.style.overflow = '';
			}, reduce ? 0 : 450);
			lastFocus?.focus({ preventScroll: true });
		};

		const tear = () => {
			if (torn || !ticket.classList.contains('is-printed')) return;
			const go = () => {
				torn = true;
				ticket.classList.add('is-torn');
				setStatus('Canhoto destacado · Nos vemos na estreia');
				if (flipBtn) flipBtn.disabled = true;
				if (tearBtn) tearBtn.disabled = true;
			};
			// Se estiver mostrando o verso, vira para a frente antes de rasgar
			if (flipped) {
				setFlip(false);
				window.setTimeout(go, reduce ? 0 : 650);
			} else go();
		};

		flipBtn?.addEventListener('click', () => !torn && setFlip(!flipped));
		tearBtn?.addEventListener('click', tear);
		ticket.querySelectorAll('[data-ticket-close]').forEach((el) => el.addEventListener('click', close));

		// Clique no ingresso: no canhoto destaca, no resto vira
		card?.addEventListener('click', (e) => {
			if (!ticket.classList.contains('is-printed')) return;
			const r = card.getBoundingClientRect();
			const onStub = !flipped && (e.clientX - r.left) / r.width > 0.709;
			if (onStub && stub && !torn) tear();
			else if (!torn) setFlip(!flipped);
		});

		// Inclinação 3D + brilho holográfico seguindo o ponteiro
		if (!reduce && window.matchMedia('(pointer: fine)').matches) {
			stage?.addEventListener('pointermove', (e) => {
				if (!ticket.classList.contains('is-printed') || !card) return;
				const r = card.getBoundingClientRect();
				const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
				const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
				ticket.classList.add('is-tilting');
				ticket.style.setProperty('--rx', `${((0.5 - y) * 14).toFixed(2)}deg`);
				ticket.style.setProperty('--ry', `${((x - 0.5) * 20).toFixed(2)}deg`);
				ticket.style.setProperty('--fx', `${(110 - x * 120).toFixed(1)}%`);
			});
			stage?.addEventListener('pointerleave', () => {
				ticket.classList.remove('is-tilting');
				ticket.style.removeProperty('--rx');
				ticket.style.removeProperty('--ry');
			});
		}

		// Teclado: Esc fecha; Tab fica dentro do ingresso
		ticket.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				e.preventDefault();
				close();
				return;
			}
			if (e.key !== 'Tab') return;
			const focusables = [...ticket.querySelectorAll<HTMLElement>('button:not([disabled])')];
			if (!focusables.length) return;
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		return open;
	})();

	// Gatilhos: marcar no Google Agenda (abre em nova aba) ou baixar o .ics
	document.querySelector('.release-btn')?.addEventListener('click', () => openTicket());
	document.querySelector('[data-save-date]')?.addEventListener('click', () => openTicket());
</script>
