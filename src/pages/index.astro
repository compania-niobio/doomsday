// Cada letra vira um <span> para o slide letra por letra (textSlide)
const split = (text: string, offset: number) =>
	[...text].map((ch, i) => ({ ch: ch === ' ' ? ' ' : ch, i: offset + i }));


// Atos da narrativa (parallax ao rolar) — cada título: linha vazada + linha preenchida
const actsRaw = [
	{
		n: '01',
		title: 'O presságio',
		head: ['Tudo o que conhecemos', 'está prestes a mudar.'],
		body: ['O equilíbrio entre os universos está desaparecendo.', 'E algo muito maior está despertando.'],
	},
	{
		n: '02',
		title: 'A ameaça',
		head: ['O maior perigo', 'não vem de outro mundo.'],
		body: ['Ele vem de alguém que acredita ter o poder de decidir o destino de todos eles.'],
	},
	{
		n: '04',
		title: 'O sacrifício',
		head: ['Nenhuma vitória', 'vem sem um preço.'],
		body: ['Alianças serão testadas.', 'Legados serão colocados à prova.', 'E o futuro nunca mais será o mesmo.'],
	},
	{
		n: '05',
		title: 'A conexão com a linha do tempo',
		head: ['Mas o fim', 'não começou agora.'],
		body: ['Cada batalha, cada escolha e cada sacrifício nos trouxeram até aqui.'],
		finale: 'Tudo está conectado.',
	},
];

const acts = actsRaw.map((act, i) => {
	let w = 0;
	const lines = act.head.map((line) => line.split(' ').map((t) => ({ t, w: w++ })));
	const align = i === actsRaw.length - 1 ? 'center' : i % 2 ? 'right' : 'left';
	// Fecho agrupado por palavra: a quebra de linha só acontece entre palavras
	let k = 0;
	const finaleWords = act.finale
		? act.finale.split(' ').map((word) => [...word].map((ch) => ({ ch, i: k++ })))
		: null;
	return { ...act, lines, align, finaleWords };
});

// Segunda dobra — linha do tempo dos filmes (sinopse vazia = ainda não definida)
const films = [
