// Cada letra vira um <span> para o slide letra por letra (textSlide)
const split = (text: string, offset: number) =>
	[...text].map((ch, i) => ({ ch: ch === ' ' ? ' ' : ch, i: offset + i }));


// Atos da narrativa (parallax ao rolar) — cada título: linha vazada + linha preenchida
const actsRaw = [
	{
		n: '01',
		title: 'O presságio',
		head: ['Tudo o que conhecemos', 'está prestes a mudar.'],
		body: ['O equilíbrio entre os universos está desaparecendo.', 'E algo muito maior está despertando.'],
	},
	{
		n: '02',
		title: 'A ameaça',
		head: ['O maior perigo', 'não vem de outro mundo.'],
		body: ['Ele vem de alguém que acredita ter o poder de decidir o destino de todos eles.'],
	},
	{
		n: '04',
		title: 'O sacrifício',
		head: ['Nenhuma vitória', 'vem sem um preço.'],
		body: ['Alianças serão testadas.', 'Legados serão colocados à prova.', 'E o futuro nunca mais será o mesmo.'],
