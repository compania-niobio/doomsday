		img: { s: thunderbolts300, m: thunderbolts600, l: thunderbolts1200 },
	},
	{
		title: 'Quarteto Fantástico: Primeiros Passos',
		year: '2025',
		synopsis:
			'Em uma realidade alternativa inspirada na estética futurista dos anos 1960, Reed Richards, Sue Storm, Johnny Storm e Ben Grimm precisam equilibrar suas vidas como família e como super-heróis. Quando Galactus, uma entidade cósmica devoradora de mundos, ameaça seu planeta, o Quarteto Fantástico enfrenta seu maior desafio, colocando em jogo o futuro de toda a humanidade.',
		img: { s: fantastic300, m: fantastic600, l: fantastic1200 },
	},
	{
		title: 'Vingadores: Doomsday',
		year: '2026',
		synopsis: '',
		img: { s: doomsday300, m: doomsday600, l: doomsday1200 },
