// ---- Linha do Tempo Sagrada: geometria do fio (unidades do mundo; altura = 1000) ----
// Cada filme é um nó sobre o fio; entre eles, ramificações (variantes) que crescem e são podadas
const SEG = 1150;
const X0 = 950;
const nodeX = films.map((_, i) => X0 + i * SEG);
const worldW = nodeX[nodeX.length - 1] + 1500;
const strandY = (x: number) => 500 + 34 * Math.sin(x / 270) + 15 * Math.sin(x / 97 + 1.3) + 6 * Math.sin(x / 41 + 0.4);

type Pt = [number, number];
const f1 = (n: number) => n.toFixed(1);
// Catmull-Rom → Bézier: curva suave passando pelos pontos amostrados
const smoothPath = (pts: Pt[]) => {
	let d = `M${f1(pts[0][0])},${f1(pts[0][1])}`;
	for (let i = 0; i < pts.length - 1; i++) {
		const p0 = pts[i - 1] ?? pts[i];
		const p1 = pts[i];
		const p2 = pts[i + 1];
		const p3 = pts[i + 2] ?? p2;
		d += ` C${f1(p1[0] + (p2[0] - p0[0]) / 6)},${f1(p1[1] + (p2[1] - p0[1]) / 6)} ${f1(p2[0] - (p3[0] - p1[0]) / 6)},${f1(p2[1] - (p3[1] - p1[1]) / 6)} ${f1(p2[0])},${f1(p2[1])}`;
	}
	return d;
};
const sampled = (fy: (x: number) => number) => {
	const pts: Pt[] = [];
	for (let x = -60; x <= worldW + 60; x += 28) pts.push([x, fy(x)]);
	return smoothPath(pts);
};
const strand = sampled(strandY);
const twistA = sampled((x) => strandY(x) + 22 * Math.sin(x / 150));
const twistB = sampled((x) => strandY(x) - 18 * Math.sin(x / 205 + 2));

// Ramificações determinísticas (mesma forma a cada build)
let seed = 20260512;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const bez = (p: Pt[], t: number): Pt => {
	const m = 1 - t;
	const k = [m * m * m, 3 * m * m * t, 3 * m * t * t, t * t * t];
	return [0, 1].map((a) => p.reduce((s, q, i) => s + q[a] * k[i], 0)) as Pt;
};
const curve = (a: Pt, len: number, rise: number, dir: number) => {
	const pts: Pt[] = [a, [a[0] + len * 0.42 * dir, a[1] + rise * 0.04], [a[0] + len * 0.66 * dir, a[1] + rise * 0.7], [a[0] + len * dir, a[1] + rise]];
	const [p0, p1, p2, p3] = pts.map((p) => `${f1(p[0])},${f1(p[1])}`);
	return { pts, d: `M${p0} C${p1} ${p2} ${p3}` };
};
const branches: { x: number; w: string; paths: string[] }[] = [];
for (let x = 40; x < worldW - 120; x += 34 + rnd() * 52) {
	if (nodeX.some((nx) => Math.abs(x - nx) < 190)) continue;
	const side = rnd() > 0.5 ? -1 : 1;
	const dir = rnd() > 0.8 ? -1 : 1;
	const main = curve([x, strandY(x)], 170 + rnd() * 270, side * (60 + rnd() * 170), dir);
	const paths = [main.d];
	if (rnd() > 0.45) paths.push(curve(bez(main.pts, 0.45 + rnd() * 0.3), 60 + rnd() * 110, side * (30 + rnd() * 80), dir).d);
	branches.push({ x: Math.round(x), w: (0.9 + rnd() * 1.5).toFixed(2), paths });
}
const filmNodes = films.map((f, i) => ({
	...f,
	x: nodeX[i],
	fx: ((nodeX[i] / worldW) * 100).toFixed(3),
	fy: (strandY(nodeX[i]) / 10).toFixed(3),
	side: i % 2 ? 'down' : 'up',
}));

// ---- Terceira dobra · A Convergência: um fio por título da linha do tempo, em espiral até o trailer ----
const trailerId = 'E1dW377oqXw';

// Estreia no Google Agenda: link oficial de criação de evento (dia inteiro, 16/12/2026), sem API
const googleCalendarUrl = `https://calendar.google.com/calendar/render?${new URLSearchParams({
	action: 'TEMPLATE',
	text: 'Estreia de Vingadores: Doomsday',
	dates: '20261216/20261217',
	details: 'Vingadores: Doomsday estreia hoje nos cinemas.',
	ctz: 'America/Sao_Paulo',
}).toString()}`;

// Faíscas que saltam da picotagem quando o canhoto é destacado (determinísticas)
const tearSparks = Array.from({ length: 16 }, (_, i) => ({
	y: ((i + 0.5) / 16) * 100,
	dx: (i % 2 ? 1 : -1) * (20 + ((i * 37) % 60)),
	dy: -30 + ((i * 53) % 70),
	delay: ((i * 29) % 12) * 18,
}));
const rays = films.map((f, i) => {
	const a = (i / films.length) * Math.PI * 2 - Math.PI / 2 + 0.17;
	const s: Pt = [800 + Math.cos(a) * 900, 500 + Math.sin(a) * 620];
	const c1: Pt = [800 + Math.cos(a + 0.6) * 560, 500 + Math.sin(a + 0.6) * 380];
	const c2: Pt = [800 + Math.cos(a + 1.05) * 170, 500 + Math.sin(a + 1.05) * 115];
	const label = bez([s, c1, c2, [800, 500]], 0.16);
	return {
		d: `M${f1(s[0])},${f1(s[1])} C${f1(c1[0])},${f1(c1[1])} ${f1(c2[0])},${f1(c2[1])} 800,500`,
		year: f.year,
		lx: Math.min(95, Math.max(5, label[0] / 16)).toFixed(2),
		ly: Math.min(93, Math.max(7, label[1] / 10)).toFixed(2),
	};
});

const fontFaces = `
@font-face { font-family: UrwDin; font-weight: 900; font-display: swap; src: url("${urwBlack}") format("woff"); }
@font-face { font-family: UrwDin; font-weight: 700; font-display: swap; src: url("${urwBold}") format("woff"); }
@font-face { font-family: UrwDin; font-weight: 600; font-display: swap; src: url("${urwDemi}") format("woff"); }
`;
---

<Layout>
	<!-- JetBrains Mono (família mono do design system) -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
	<Fragment set:html={`<style>${fontFaces}</style>`} />

	<div class="noise" aria-hidden="true"></div>

	<main class="page">
		<!-- ================= HISTÓRIA: vídeo controlado pela rolagem + atos em parallax ================= -->
		<section class="story" id="top" data-story aria-labelledby="story-title">
		<!-- Palco fixo (sticky): o card com o vídeo fica parado enquanto os atos rolam por cima -->
		<div class="hero" data-hero>
			<!-- Loader: aparece enquanto a fenda cinemascope não abre -->
			<div class="hero-loader" aria-hidden="true">
				<svg class="ring-loader" viewBox="0 0 50 50"><circle cx="25" cy="25" r="20" fill="none" stroke="#ccff00" stroke-width="4" stroke-linecap="round"></circle></svg>
				<span>Carregando o fim</span>
			</div>

			<div class="hero-card">
				<!-- Mídia: o tempo do vídeo acompanha a rolagem (scrub) -->
				<div class="hero-media" aria-hidden="true">
					<video
						class="hero-video"
						src={introVideo}
						muted
						playsinline
						preload="auto"
						data-hero-video
					></video>
				</div>

				<!-- Atmosfera (design system: vignette, grid-drift) -->
				<div class="hero-shade" aria-hidden="true"></div>
				<div class="acts-shade" aria-hidden="true"></div>
				<div class="grid-drift" aria-hidden="true"></div>
				<div class="acts-glow" aria-hidden="true"></div>

				<!-- ===== NAV ===== -->
				<!-- transition:persist: o topo não é recriado entre páginas (ClientRouter) -->
				<header class="hero-nav nav-load" transition:persist="site-header">
					<a href="#top" class="brand" aria-label="Vingadores: Doomsday — início">
						<span class="brand-mark">
							<span class="radar-ring"></span>
							<img src={logoNiobio} alt="" width="32" height="32" />
						</span>
					</a>

					<div class="nav-actions">
						<a href="#conta" class="icon-btn" aria-label="Minha conta">
							<svg viewBox="0 0 24 24" class="icon-base"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>
						</a>
						<a href="#ingressos" class="icon-btn" aria-label="Ingressos">
							<svg viewBox="0 0 24 24" class="icon-base"><path d="M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4z"></path><path d="M14 6v12" stroke-dasharray="2 2.5"></path></svg>
							<span class="badge" aria-hidden="true"></span>
						</a>
					</div>
				</header>

				<!-- "Role para descobrir": some quando a rolagem começa -->
				<div class="intro-fade">
					<a href="#filme" class="hud hud--right reveal" style="--d:2.3s">
						<span>Role para descobrir</span>
						<svg viewBox="0 0 24 24" class="icon-base hud-arrow"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
					</a>
				</div>

				<!-- ===== HUD inferior: timecode acompanha o vídeo ===== -->
				<div class="hud hud--left reveal" style="--d:2.3s">
					<span>Cap. 01</span>
					<span class="hud-sep"></span>
					<span class="hud-time" data-timecode>00:00.0</span>
				</div>
			</div>
		</div>

		<!-- Trilha que gera a rolagem: o Ato 01 já ocupa a primeira tela -->
		<div class="story-track" data-acts>
			<h1 id="story-title" class="sr-only">Vingadores: Doomsday</h1>

			<div id="filme"></div>
			{acts.map((a) => (
				<article class={`act act--${a.align}`} data-act>
					<div class="act-inner">
						<h2 class="act-head" aria-label={a.head.join(' ')}>
							{a.lines.map((words, li) => (
								<span class={`hl hl--${li === 0 ? 'outline' : 'fill'}`} aria-hidden="true">
									{words.map((wd) => (
										<Fragment><span class="w" style={`--w:${wd.w}`}>{wd.t}</span>{' '}</Fragment>
									))}
								</span>
							))}
						</h2>
						<div class="act-body">
							{a.body.map((b, j) => <p style={`--j:${j}`}>{b}</p>)}
						</div>
						{a.finaleWords && (
							<p class="act-finale" aria-label={a.finale}>
								{a.finaleWords.map((word) => (
									<span class="fw" aria-hidden="true">
										{word.map((l) => (
											<span class="ch" style={`--i:${l.i}`}>{l.ch}</span>
										))}
									</span>
								))}
							</p>
						)}
					</div>
				</article>
			))}
			<div class="story-outro" aria-hidden="true"></div>
		</div>
		</section>

		<!-- ================= SEGUNDA DOBRA · LINHA DO TEMPO SAGRADA ================= -->
		<section class="saga" id="linha-do-tempo" aria-label="Linha do tempo dos filmes" data-saga style={`--n:${films.length}`}>
			<!-- Palco fixo: a rolagem conduz a câmera ao longo do fio -->
			<div class="saga-sticky">
			<div class="saga-card" data-saga-card>
				<!-- Fundo: pôster do filme ativo, bem escuro, em crossfade -->
				<div class="saga-bg" aria-hidden="true">
					{films.map((f) => (
						<img src={f.img.l} alt="" loading="lazy" decoding="async" data-film-bg />
					))}
				</div>
				<div class="saga-shade" aria-hidden="true"></div>
				<div class="grid-drift" aria-hidden="true"></div>

				<!-- Limites do multiverso: lente vermelha em volta do fio -->
				<svg class="sg-bounds" viewBox="0 0 1600 1000" preserveAspectRatio="none" aria-hidden="true">
					<g class="sg-bounds-glow">
						<path d="M-40,250 C420,-20 1180,-20 1640,250" />
						<path d="M-40,750 C420,1020 1180,1020 1640,750" />
					</g>
					<g class="sg-bounds-line">
						<path d="M-40,250 C420,-20 1180,-20 1640,250" />
						<path d="M-40,750 C420,1020 1180,1020 1640,750" />
					</g>
					<g class="sg-bounds-dash">
						<path d="M-40,330 C420,140 1180,140 1640,330" />
						<path d="M-40,670 C420,860 1180,860 1640,670" />
					</g>
				</svg>

				<!-- O fio: trilha larga que desliza conforme a rolagem -->
				<div class="sg-stage" data-sg-stage>
					<div class="sg-track" data-sg-track style={`--w:${worldW}`}>
						<svg class="sg-svg sg-glow" viewBox={`0 0 ${worldW} 1000`} aria-hidden="true">
							<path d={strand} />
						</svg>
						<svg class="sg-svg sg-branches" viewBox={`0 0 ${worldW} 1000`} aria-hidden="true">
							{branches.map((b) => (
								<g class="sg-branch" data-bx={b.x} stroke-width={b.w}>
									{b.paths.map((d) => <path d={d} pathLength="1" />)}
								</g>
							))}
						</svg>
						<svg class="sg-svg sg-lines" viewBox={`0 0 ${worldW} 1000`} aria-hidden="true">
							<path class="sg-twist sg-twist--a" d={twistA} />
							<path class="sg-twist sg-twist--b" d={twistB} />
							<path class="sg-core" d={strand} />
						</svg>
						<svg class="sg-svg sg-pulse" viewBox={`0 0 ${worldW} 1000`} aria-hidden="true">
							<path d={strand} pathLength="1" />
						</svg>

						{filmNodes.map((f, i) => (
							<div
								class={`sg-film sg-film--${f.side}`}
								data-film={i}
								data-x={f.x}
								data-title={f.title}
								data-year={f.year}
								data-n={f.n}
								data-synopsis={f.synopsis}
								style={`--fx:${f.fx};--fy:${f.fy}`}
							>
								<span class="sg-year" aria-hidden="true">{f.year}</span>
								<span class="sg-leader" aria-hidden="true"></span>
								<button class="sg-card" type="button" aria-label={`${f.title} (${f.year})`}>
									<span class="sg-poster tilt-card" data-tilt-poster>
										<img src={f.img.m} srcset={`${f.img.s} 300w, ${f.img.m} 600w, ${f.img.l} 1200w`} sizes="(max-width: 900px) 30vw, 220px" alt={`Pôster de ${f.title} (${f.year})`} loading="lazy" decoding="async" draggable="false" />
									</span>
									<span class="sg-meta" aria-hidden="true">
										<span class="sg-meta-cap">Capítulo {f.n}</span>
										<span class="sg-meta-title">{f.title}</span>
										<span class="sg-meta-year">{f.year}</span>
									</span>
								</button>
								<span class="sg-node" aria-hidden="true">
									<span class="radar-ring"></span>
									<span class="sg-node-n">{f.n}</span>
								</span>
							</div>
						))}
					</div>
				</div>

				<!-- Texto do filme ativo -->
				<div class="saga-copy" data-saga-copy aria-live="polite">
					<p class="saga-eyebrow s-rv" style="--d:0.1s">
						<span class="pulse-dot"></span>Linha do tempo <span class="saga-eyebrow-sep"></span> <span data-saga-chapter>Capítulo {films[0].n}</span>
					</p>
					<h2 class="saga-title" data-saga-title aria-label={`${films[0].title} (${films[0].year})`}></h2>
					<p class="saga-synopsis s-rv" style="--d:0.5s" data-saga-synopsis>{films[0].synopsis}</p>
				</div>

				<!-- HUD: ano corrente no fio + variantes podadas -->
				<div class="sg-hud s-rv" style="--d:0.4s" aria-hidden="true">
					<span class="sg-hud-row"><span class="sg-hud-dot"></span>Linha do tempo sagrada</span>
					<span class="sg-hud-row">T <b data-sg-t>{films[0].year}.0</b></span>
					<span class="sg-hud-row">Variantes podadas <b data-sg-pruned>000</b></span>
				</div>
			</div>
			</div>
		</section>
		<!-- ================= TERCEIRA DOBRA · A CONVERGÊNCIA (TRAILER) ================= -->
		<section class="doom" id="trailer" aria-labelledby="doom-title" data-doom data-video={trailerId}>
			<!-- Palco fixo: os fios convergem, a palavra é engolida e a fenda se abre no trailer -->
			<div class="doom-sticky">
			<div class="doom-card" data-doom-card>
				<div class="grid-drift" aria-hidden="true"></div>
				<div class="doom-vignette" aria-hidden="true"></div>

				<!-- Luz do trailer projetada na página (ambilight) -->
				<div class="doom-ambi" aria-hidden="true">
					<img src={`https://i.ytimg.com/vi/${trailerId}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
				</div>

				<!-- Fios de todos os títulos convergindo em espiral -->
				<svg class="doom-rays" viewBox="0 0 1600 1000" preserveAspectRatio="none" aria-hidden="true">
					{rays.map((r) => (
						<g class="doom-ray">
							<path class="doom-ray-line" d={r.d} pathLength="1" data-doom-ray />
							<path class="doom-ray-spark" d={r.d} pathLength="1" />
						</g>
					))}
				</svg>
				<div class="doom-years" aria-hidden="true">
					{rays.map((r, i) => (
						<span class="doom-year" style={`left:${r.lx}%;top:${r.ly}%;--i:${i}`}>{r.year}</span>
					))}
				</div>

				<!-- A palavra que o ponto engole -->
				<h2 class="sr-only" id="doom-title">Vingadores: Doomsday — trailer</h2>

				<!-- Singularidade -->
				<div class="doom-core" aria-hidden="true"><span class="radar-ring"></span><span class="radar-ring r2"></span></div>

				<!-- A fenda: brilho da borda + tela do trailer recortada pelo JS -->
				<div class="doom-rift" aria-hidden="true" data-doom-rift></div>
				<div class="doom-screen" data-doom-screen>
					<div class="doom-media" data-doom-media>
						<img class="doom-thumb" src={`https://i.ytimg.com/vi/${trailerId}/maxresdefault.jpg`} alt="Cena do trailer de Vingadores: Doomsday" loading="lazy" decoding="async" data-doom-thumb />
						<div class="doom-shade" aria-hidden="true"></div>
						<button class="doom-play beam-pill" type="button" data-doom-play>
							<span class="halo"></span>
							<span class="beam-spin"></span>
							<span class="beam-inner">
								<span class="shine"></span>
								<svg viewBox="0 0 24 24" class="doom-play-icon" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
								<span class="doom-play-label">Assistir ao trailer</span>
							</span>
						</button>
					</div>
					<!-- Cantos de mira + rótulos (HUD) -->
					<span class="doom-corner doom-corner--tl" aria-hidden="true"></span>
					<span class="doom-corner doom-corner--tr" aria-hidden="true"></span>
					<span class="doom-corner doom-corner--bl" aria-hidden="true"></span>
					<span class="doom-corner doom-corner--br" aria-hidden="true"></span>
				</div>

				<!-- HUD do quadro -->
				<div class="doom-hud doom-hud--top" aria-hidden="true">
					<span><span class="doom-rec"></span><span data-doom-status>Sinal interceptado</span></span>
				</div>
			</div>
			</div>
		</section>

		<!-- ================= QUARTA DOBRA · MARQUEE DE VÍDEO (sem overlay) ================= -->
		<section class="final" aria-label="Vídeo final" data-final>
			<!-- Fonte única: um só vídeo é decodificado; cada cópia da faixa recebe o quadro atual (canvas) -->
			<video class="final-source" src={finalVideo} muted loop playsinline preload="auto" aria-hidden="true" data-final-video></video>

			<!-- Marquee (design system · .marquee-container): faixa de vídeos deslizando -->
			<div class="final-marquee" aria-hidden="true" data-final-marquee>
				<div class="final-marquee-track">
					{[0, 1].map(() => (
						<div class="final-marquee-group">
							{[0, 1, 2].map(() => (
								<canvas class="final-tile" width="960" height="402" data-final-tile></canvas>
							))}
						</div>
					))}
				</div>
			</div>

			<!-- Estreia: contagem regressiva + botão para salvar a data no calendário -->
			<div class="release" data-release data-target="2026-12-16T00:00:00-03:00">
				<p class="release-date"><span class="pulse-dot"></span>Estreia <span class="saga-eyebrow-sep"></span> 16 de dezembro de 2026</p>

				<div class="countdown" aria-label="Contagem regressiva para a estreia de Vingadores: Doomsday">
					{[
						{ k: 'd', label: 'Dias' },
						{ k: 'h', label: 'Horas' },
						{ k: 'm', label: 'Minutos' },
						{ k: 's', label: 'Segundos' },
					].map((u, i) => (
						<>
							{i > 0 && <span class="countdown-sep" aria-hidden="true">:</span>}
							<div class="countdown-unit">
								<span class="countdown-value" data-cd={u.k}>00</span>
								<span class="countdown-label">{u.label}</span>
							</div>
						</>
					))}
				</div>
				<p class="countdown-done" data-cd-done hidden>Chegou o dia.</p>

				<!-- Principal: abre o Google Agenda com o evento já preenchido (nova aba) -->
				<a class="beam-pill release-btn" href={googleCalendarUrl} target="_blank" rel="noopener noreferrer" aria-label="Marcar o dia no Google Agenda (abre em nova aba)">
					<span class="halo"></span>
					<span class="beam-spin"></span>
					<span class="beam-inner">
						<span class="shine"></span>
						<svg viewBox="0 0 24 24" class="release-icon" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path><path d="M9.5 14.5l2 2 3.5-3.5"></path></svg>
						<span class="release-label">Marcar no Google Agenda</span>
					</span>
				</a>

				<!-- Alternativa: arquivo .ics para Apple, Outlook e outros calendários -->
				<button class="release-ics" type="button" data-save-date>
					<span data-save-label>Usa outro calendário? Baixar arquivo .ics</span>
				</button>
			</div>

			<!-- Mesmo marquee de vídeo, repetido abaixo do botão -->
			<div class="final-marquee" aria-hidden="true" data-final-marquee>
				<div class="final-marquee-track">
					{[0, 1].map(() => (
						<div class="final-marquee-group">
							{[0, 1, 2].map(() => (
								<canvas class="final-tile" width="960" height="402" data-final-tile></canvas>
							))}
						</div>
					))}
				</div>
			</div>
		</section>
	</main>

	<!-- ================= INGRESSO · A EMISSÃO (aparece depois de marcar o dia) ================= -->
	<div class="tk-modal" role="dialog" aria-modal="true" aria-label="Seu ingresso de Vingadores: Doomsday" hidden data-ticket style={`--tk-front:url(${ticketFront});--tk-back:url(${ticketBack})`}>
		<div class="tk-backdrop" data-ticket-close></div>
		<div class="tk-stage" data-ticket-stage>
			<p class="tk-status"><span class="pulse-dot"></span><span data-ticket-status>Emitindo ingresso</span></p>

			<div class="tk-wrap">
				<!-- A fenda de onde o ingresso é impresso -->
				<div class="tk-slot" aria-hidden="true"></div>
				<div class="tk-shadow" aria-hidden="true"></div>
				<div class="tk-emit">
					<div class="tk-print">
						<div class="tk" data-ticket-card>
							<!-- Frente: corpo + canhoto (o canhoto pode ser destacado) -->
							<div class="tk-face tk-front tk-front--main" role="img" aria-label="Frente do ingresso: Doutor Destino">
								<span class="tk-foil" aria-hidden="true"></span>
							</div>
							<div class="tk-face tk-front tk-front--stub" data-ticket-stub aria-hidden="true">
								<span class="tk-foil"></span>
								<span class="tk-laser"></span>
							</div>
							<span class="tk-perf" aria-hidden="true"></span>
							<span class="tk-sparks" aria-hidden="true">
								{tearSparks.map((s) => (
									<span style={`--y:${s.y}%;--dx:${s.dx}px;--dy:${s.dy}px;--sd:${s.delay}ms`}></span>
								))}
							</span>
							<!-- Verso -->
							<div class="tk-face tk-back" role="img" aria-label="Verso do ingresso: Avengers Doomsday"></div>
						</div>
					</div>
				</div>
			</div>

			<div class="tk-actions">
				<button class="tk-btn" type="button" data-ticket-flip>Virar ingresso</button>
				<button class="tk-btn" type="button" data-ticket-tear>Destacar canhoto</button>
			</div>

			<button class="icon-btn tk-close" type="button" aria-label="Fechar ingresso" data-ticket-close>
				<svg viewBox="0 0 24 24" class="icon-base" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
			</button>
		</div>
	</div>
</Layout>

<style is:global>
	/* =========================================================
	   TOKENS — src/assets/design_system.html
	   ========================================================= */
	@font-face {
		font-family: Inspire;
		font-weight: 400;
		font-display: swap;
		src: url('https://static-assets.bamgrid.com/fonts/inspire/Inspire-Regular.f2199f841165c4ddbafcf177da3ef974.woff2') format('woff2');
	}
	@font-face {
		font-family: Inspire;
		font-weight: 600;
		font-display: swap;
		src: url('https://static-assets.bamgrid.com/fonts/inspire/Inspire-Bold.4ff15ddc93445342649194969715b0b5.woff2') format('woff2');
	}

	:root {
		--ink: #1c1c1c;
		--graphite: #6b6b6b;
		--bone: #f5f5f0;
		--obsidian: #09090b;
		--acid: #ccff00;
		--ember: #ff3300;

		--ff-display: 'UrwDin', 'Inspire', 'Trebuchet MS', Helvetica, Arial, sans-serif;
		--ff-body: 'Inspire', 'Inter', -apple-system, 'Segoe UI', Roboto, sans-serif;
		--ff-mono: 'JetBrains Mono', ui-monospace, monospace;

		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
		--ease-elastic: cubic-bezier(0.34, 1.56, 0.64, 1);

		--frame: clamp(8px, 1.1vw, 16px);
		--radius: clamp(20px, 2.2vw, 32px);
		--gutter: clamp(16px, 4vw, 64px);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--obsidian);
	}

	body {
		font-family: var(--ff-body);
		background: var(--obsidian);
		color: #fff;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
	}

	::selection {
		background: var(--ink);
		color: var(--acid);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Noise (animations-gemini2) */
	.noise {
		position: fixed;
		inset: 0;
		opacity: 0.06;
		pointer-events: none;
		z-index: 9999;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
	}

	/* =========================================================
	   HERO — moldura
	   ========================================================= */
	.story {
		position: relative;
		background: var(--obsidian);
	}

	/* Palco fixo: fica preso no topo durante toda a história; a trilha rola por cima */
	.hero {
		position: sticky;
		top: 0;
		z-index: 0;
		height: 100svh;
		margin-bottom: -100svh;
		padding: var(--frame);
		isolation: isolate;
	}

	.hero-card {
		position: relative;
		height: 100%;
		border-radius: var(--radius);
		overflow: hidden;
		background: #000;
		isolation: isolate;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 40px 120px -40px rgba(204, 255, 0, 0.12);
		/* Abertura em fenda cinemascope */
		clip-path: inset(47% 0 47% 0 round var(--radius));
		transition: clip-path 1.5s var(--ease-out), transform 0.2s linear;
		transform-origin: 50% 0;
		will-change: clip-path, transform;
	}

	.is-ready .hero-card {
		clip-path: inset(0 0 0 0 round var(--radius));
	}

	.hero-loader {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 14px;
		font: 500 11px/1 var(--ff-mono);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.5);
		transition: opacity 0.5s ease;
		z-index: 0;
	}

	.hero-loader .ring-loader {
		width: 28px;
		height: 28px;
	}

	.is-ready .hero-loader {
		opacity: 0;
	}

	/* =========================================================
	   MÍDIA + ATMOSFERA
	   ========================================================= */
	/* Parallax do vídeo: sobe devagar e aproxima conforme a rolagem (--sp 0→1) */
	.hero-media {
		position: absolute;
		inset: -8%;
		z-index: 0;
		transform:
			translate3d(0, calc(var(--sp, 0) * -7vh), 0)
			scale(calc(1 + var(--sp, 0) * 0.14));
		transition: transform 0.6s var(--ease-out);
		will-change: transform;
	}

	.hero-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 55%;
		filter: brightness(0.82) contrast(1.08) saturate(0.9);
		transform: scale(1.18);
		transition: transform 2.8s var(--ease-out);
	}

	.is-ready .hero-video {
		transform: scale(1);
	}

	.hero-shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(120% 90% at 50% 45%, transparent 35%, rgba(9, 9, 11, 0.75) 100%),
			linear-gradient(to bottom, rgba(9, 9, 11, 0.7) 0%, rgba(9, 9, 11, 0.15) 22%, rgba(9, 9, 11, 0.05) 55%, rgba(9, 9, 11, 0.85) 100%);
	}

	.grid-drift {
		position: absolute;
		inset: -80px;
		z-index: 1;
		pointer-events: none;
		background-size: 40px 40px;
		background-image:
			linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
		animation: gridDrift 24s linear infinite;
		-webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%);
		mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%);
	}

	@keyframes gridDrift {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(40px, 40px, 0); }
	}

	/* =========================================================
	   NAV (design system: glass + nav-link + radar-ring + beam)
	   ========================================================= */
	.hero-nav {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 16px;
		padding: clamp(14px, 2vw, 26px) var(--gutter);
	}

	.nav-load {
		opacity: 0;
		transform: translateY(-10px);
		transition: opacity 0.8s ease-out 1s, transform 0.8s ease-out 1s;
	}

	.is-ready .nav-load {
		opacity: 1;
		transform: none;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		justify-self: start;
	}

	.brand-mark {
		position: relative;
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
	}

	.brand-mark img {
		position: relative;
		width: 32px;
		height: 32px;
		object-fit: contain;
		transition: transform 0.7s var(--ease-out);
	}

	.brand:hover .brand-mark img {
		transform: rotate(180deg);
	}

	.nav-actions {
		justify-self: end;
		display: flex;
		gap: 8px;
	}

	.icon-btn {
		position: relative;
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		color: #fff;
		background: rgba(23, 23, 23, 0.45);
		border: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		transition: background 0.3s, color 0.3s, transform 0.4s var(--ease-elastic);
	}

	.icon-btn svg {
		width: 18px;
		height: 18px;
	}

	.icon-btn:hover {
		background: var(--acid);
		color: var(--ink);
		transform: translateY(-2px);
	}

	.badge {
		position: absolute;
		top: 7px;
		right: 7px;
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--ember);
		box-shadow: 0 0 0 2px rgba(9, 9, 11, 0.9);
	}

	.icon-base {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Keyframes de texto (design system: textSlide + glitch) */
	@keyframes glitch {
		0%, 92%, 100% { transform: none; filter: none; }
		93% { transform: translate(-3px, 1px) skewX(-6deg); filter: drop-shadow(3px 0 0 #ff3300); }
		94% { transform: translate(3px, -1px); filter: drop-shadow(-3px 0 0 #ffffff); }
		95% { transform: translate(-1px, 0) skewX(4deg); filter: drop-shadow(2px 0 0 #ff3300); }
	}

	@keyframes textSlide {
		0% { transform: translateY(110%); opacity: 0; }
		100% { transform: translateY(0); opacity: 1; }
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.radar-ring {
		position: absolute;
		inset: 0;
		border: 2px solid rgba(255, 255, 255, 0.35);
		border-radius: 999px;
		animation: radar 2.4s var(--ease-out) infinite;
		pointer-events: none;
	}

	.radar-ring.r2 {
		animation-delay: 1.2s;
	}

	@keyframes radar {
		0% { transform: scale(0.5); opacity: 1; border-width: 2px; }
		100% { transform: scale(2.5); opacity: 0; border-width: 0; }
	}

	.ring-loader circle {
		animation: ring-dash 1.5s ease-in-out infinite;
	}

	@keyframes ring-dash {
		0% { stroke-dasharray: 1, 200; stroke-dashoffset: 0; }
		50% { stroke-dasharray: 90, 200; stroke-dashoffset: -35px; }
		100% { stroke-dasharray: 90, 200; stroke-dashoffset: -124px; }
	}

	/* HUD */
	.hud {
		position: absolute;
		z-index: 6;
		bottom: clamp(28px, 5vh, 52px);
		height: 64px;
		display: flex;
		align-items: center;
		gap: 12px;
		font: 500 10px/1 var(--ff-mono);
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.6);
	}

	.hud--left {
		left: var(--gutter);
	}

	.hud--right {
		right: var(--gutter);
		transition: color 0.3s;
	}

	.hud--right:hover {
		color: var(--acid);
	}

	.hud-sep {
		width: 28px;
		height: 1px;
		background: rgba(255, 255, 255, 0.3);
	}

	.hud-time {
		color: #fff;
		font-variant-numeric: tabular-nums;
	}

	.hud-arrow {
		width: 16px;
		height: 16px;
		animation: bounce 1.6s ease-in-out infinite;
	}

	@keyframes bounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(4px); }
	}

	/* Reveal com desfoque (design system .reveal) */
	.reveal {
		opacity: 0;
		filter: blur(8px);
		translate: 0 1.5rem;
		transition:
			opacity 1s var(--ease-out) var(--d, 0s),
			filter 1s var(--ease-out) var(--d, 0s),
			translate 1s var(--ease-out) var(--d, 0s);
	}

	.is-ready .reveal {
		opacity: 1;
		filter: blur(0);
		translate: 0 0;
	}

	/* =========================================================
	   ATOS — parallax ao rolar
	   ========================================================= */
	/* Trilha que gera a rolagem — passa por cima do palco fixo */
	.story-track {
		position: relative;
		z-index: 1;
		pointer-events: none;
	}

	/* Folga final para o vídeo chegar ao último quadro antes de soltar o palco */
	.story-outro {
		height: 40svh;
	}

	/* "Role para descobrir" some quando a rolagem começa (--intro 0→1) */
	.intro-fade {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
		opacity: calc(1 - var(--intro, 0) * 1.6);
	}

	.intro-fade > * {
		pointer-events: auto;
	}

	.is-past-intro .intro-fade > * {
		pointer-events: none;
	}

	/* Sombra que acompanha o lado do texto (--gx) para manter a leitura */
	.acts-shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(70vw 95vh at var(--gx, 28%) 50%, rgba(9, 9, 11, 0.62), transparent 72%),
			linear-gradient(to bottom, rgba(9, 9, 11, 0.55) 0%, rgba(9, 9, 11, 0.25) 30%, rgba(9, 9, 11, 0.25) 70%, rgba(9, 9, 11, 0.7) 100%);
	}

	.acts-glow {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background: radial-gradient(48vw circle at var(--gx, 28%) 50%, rgba(204, 255, 0, 0.09), transparent 62%);
	}

	/* Cada ato */
	.act {
		position: relative;
		z-index: 1;
		min-height: 110svh;
		display: grid;
		align-content: center;
		padding: 0 var(--gutter);
	}

	.act--right {
		justify-items: end;
		text-align: right;
	}

	.act--center {
		justify-items: center;
		text-align: center;
	}

	.act-inner {
		position: relative;
		max-width: min(1200px, 100%);
		opacity: var(--o, 1);
		transform: translate3d(0, calc(var(--p, 0) * 70px), 0);
		will-change: transform, opacity;
	}

	.act-head {
		margin: 0;
		font: 900 clamp(2.6rem, 7.4vw, 8.4rem) / 0.86 var(--ff-display);
		text-transform: uppercase;
		letter-spacing: -0.005em;
	}

	.act-head .hl {
		display: block;
		overflow: hidden;
		/* espaço para acentos (Á, É, Ó), cedilha (Ç) e o traço do outline */
		padding: 0.16em 0.03em 0.27em;
		margin-top: -0.16em;
		margin-bottom: -0.24em;
	}

	.act-head .w {
		display: inline-block;
		/* estende a área pintada pelo background-clip até a cedilha (Ç) */
		padding-bottom: 0.26em;
		margin-bottom: -0.26em;
		transform: translateY(110%);
		opacity: 0;
	}

	.hl--outline .w {
		color: transparent;
		-webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);
	}

	.hl--fill .w {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.72) 50%, rgba(255, 255, 255, 0.18) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.act.is-in .act-head .w {
		animation: textSlide 0.9s var(--ease-out) calc(0.15s + var(--w) * 70ms) forwards;
	}

	.act-body {
		margin-top: clamp(24px, 3.2vw, 44px);
		max-width: 42ch;
	}

	.act--right .act-body {
		margin-left: auto;
	}

	.act--center .act-body {
		margin-inline: auto;
	}

	.act-body p {
		margin: 0;
		font: 400 clamp(1rem, 1.3vw, 1.25rem) / 1.6 var(--ff-body);
		color: rgba(255, 255, 255, 0.68);
		opacity: 0;
		filter: blur(8px);
		translate: 0 1.2rem;
		transition:
			opacity 1s var(--ease-out),
			filter 1s var(--ease-out),
			translate 1s var(--ease-out);
		transition-delay: calc(0.6s + var(--j) * 0.15s);
	}

	.act.is-in .act-body p {
		opacity: 1;
		filter: blur(0);
		translate: 0 0;
	}

	/* Fecho: TUDO ESTÁ CONECTADO. em Acid com glitch (como o CAOS. do hero) */
	.act-finale {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.06em 0.4em;
		overflow: hidden;
		margin: clamp(48px, 9vh, 110px) 0 0;
		padding: 0.18em 0.04em 0.03em;
		font: 900 clamp(2.4rem, 8.6vw, 10rem) / 0.86 var(--ff-display);
		text-transform: uppercase;
	}

	.act-finale .fw {
		display: inline-flex;
		white-space: nowrap;
	}

	.act-finale .ch {
		display: inline-block;
		white-space: pre;
		background: linear-gradient(180deg, #ccff00 0%, #ccff00 55%, rgba(204, 255, 0, 0.35) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		transform: translateY(110%);
		opacity: 0;
	}

	.act.is-in .act-finale .ch {
		animation:
			textSlide 0.9s var(--ease-out) calc(1.1s + var(--i) * 30ms) forwards,
			glitch 6s steps(1) calc(3s + var(--i) * 30ms) infinite;
	}

	/* =========================================================
	   SEGUNDA DOBRA · LINHA DO TEMPO SAGRADA
	   Fio de luz com ramificações que crescem e são podadas
	   ========================================================= */
	/* Altura = 1 tela + um trecho de rolagem por filme */
	.saga {
		position: relative;
		height: calc(100svh + var(--n, 1) * 85svh);
		background: var(--obsidian);
	}

	.saga-sticky {
		position: sticky;
		top: 0;
		height: 100svh;
		padding: var(--frame);
	}

	.saga-card {
		position: relative;
		height: calc(100svh - var(--frame) * 2);
		min-height: 640px;
		border-radius: var(--radius);
		overflow: hidden;
		isolation: isolate;
		background: radial-gradient(120% 90% at 62% 50%, #14130f 0%, #070708 70%);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 40px 120px -40px rgba(255, 51, 0, 0.14);
	}

	/* Fundo: pôster ativo quase apagado + parallax do cursor */
	.saga-bg img {
		position: absolute;
		inset: -5%;
		width: 110%;
		height: 110%;
		object-fit: cover;
		object-position: 50% 22%;
		opacity: 0;
		filter: blur(10px) brightness(0.32) saturate(0.6);
		transform: scale(1.14);
		transition: opacity 1.1s var(--ease-out), transform 2.6s var(--ease-out);
	}

	.saga-bg img.is-active {
		opacity: 0.8;
		transform: translate3d(var(--bx, 0px), var(--by, 0px), 0) scale(1.02);
	}

	.saga-shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(90deg, rgba(9, 9, 11, 0.96) 0%, rgba(9, 9, 11, 0.8) 30%, rgba(9, 9, 11, 0.25) 56%, rgba(9, 9, 11, 0.55) 100%),
			linear-gradient(to bottom, rgba(9, 9, 11, 0.6) 0%, transparent 22%, transparent 78%, rgba(9, 9, 11, 0.85) 100%);
	}

	/* Reveal com desfoque ao entrar na tela (design system .reveal) */
	.s-rv {
		opacity: 0;
		filter: blur(8px);
		translate: 0 1.5rem;
		transition:
			opacity 1s var(--ease-out) var(--d, 0s),
			filter 1s var(--ease-out) var(--d, 0s),
			translate 1s var(--ease-out) var(--d, 0s);
	}

	.saga.is-in .s-rv {
		opacity: 1;
		filter: blur(0);
		translate: 0 0;
	}

	/* Lente vermelha: os limites do multiverso */
	.sg-bounds {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0;
		transition: opacity 1.6s var(--ease-out) 0.3s;
	}

	.saga.is-in .sg-bounds {
		opacity: 1;
	}

	.sg-bounds path {
		fill: none;
		vector-effect: non-scaling-stroke;
	}

	.sg-bounds-glow {
		filter: blur(7px);
		animation: sgBreathe 4.8s ease-in-out infinite alternate;
	}

	.sg-bounds-glow path {
		stroke: var(--ember);
		stroke-width: 7;
		opacity: 0.55;
	}

	.sg-bounds-line path {
		stroke: var(--ember);
		stroke-width: 1.6;
		opacity: 0.9;
	}

	.sg-bounds-dash path {
		stroke: rgba(255, 51, 0, 0.4);
		stroke-width: 1;
		stroke-dasharray: 2 12;
	}

	@keyframes sgBreathe {
		from { opacity: 0.45; }
		to { opacity: 1; }
	}

	/* Palco do fio: o lado esquerdo some sob o texto */
	.sg-stage {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: hidden;
		container-type: size;
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.12) 24%, #000 48%, #000 93%, transparent 100%);
		mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.12) 24%, #000 48%, #000 93%, transparent 100%);
	}

	.sg-track {
		position: absolute;
		left: 0;
		top: 0;
		height: 100cqh;
		width: calc(100cqh * var(--w) / 1000);
		transform: translate3d(var(--tx, 0px), 0, 0);
		will-change: transform;
	}

	.sg-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.sg-svg path {
		fill: none;
		stroke-linecap: round;
	}

	/* Entrada: o fio se acende da esquerda para a direita */
	.sg-glow,
	.sg-lines,
	.sg-pulse {
		clip-path: inset(0 100% 0 0);
		transition: clip-path 2.8s var(--ease-out) 0.2s;
	}

	.saga.is-in .sg-glow,
	.saga.is-in .sg-lines,
	.saga.is-in .sg-pulse {
		clip-path: inset(0 0 0 0);
	}

	.sg-glow {
		filter: blur(9px);
	}

	.sg-glow path {
		stroke: var(--acid);
		stroke-width: 18;
		opacity: 0.42;
	}

	.sg-core {
		stroke: #fffef2;
		stroke-width: 3.4;
	}

	.sg-lines {
		filter: drop-shadow(0 0 5px rgba(204, 255, 0, 0.85)) drop-shadow(0 0 16px rgba(204, 255, 0, 0.35));
	}

	/* Fios que se enroscam no principal (referência 1) */
	.sg-twist {
		stroke-width: 1.2;
	}

	.sg-twist--a {
		stroke: var(--ember);
		opacity: 0.7;
	}

	.sg-twist--b {
		stroke: var(--bone);
		opacity: 0.28;
	}

	/* Faíscas correndo pelo fio */
	.sg-pulse {
		filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.9));
	}

	.sg-pulse path {
		stroke: #fff;
		stroke-width: 5;
		stroke-dasharray: 0.006 0.094;
		animation: sgPulse 3.2s linear infinite;
	}

	@keyframes sgPulse {
		to { stroke-dashoffset: -0.1; }
	}

	/* Ramificações: crescem ao se aproximar (JS controla o dashoffset) */
	.sg-branches {
		filter: drop-shadow(0 0 3px rgba(255, 51, 0, 0.55));
	}

	.sg-branch {
		stroke: var(--bone);
		opacity: 0.85;
	}

	.sg-branch path {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	/* Podada: pisca em Ember e se apaga */
	.sg-branch.is-pruned {
		animation: sgPrune 0.9s var(--ease-out) forwards;
	}

	@keyframes sgPrune {
		0% { stroke: var(--bone); opacity: 0.85; }
		22% { stroke: var(--ember); opacity: 1; }
		100% { stroke: var(--ember); opacity: 0; }
	}

	/* Filmes: nó sobre o fio + pôster pendurado por uma linha de circuito */
	.sg-film {
		position: absolute;
		left: calc(var(--fx) * 1%);
		top: calc(var(--fy) * 1%);
		width: 0;
		height: 0;
		z-index: 2;
	}

	.sg-node {
		position: absolute;
		left: 0;
		top: 0;
		width: max(40px, 5.4cqh);
		aspect-ratio: 1;
		translate: -50% -50%;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: radial-gradient(circle, #1b1b12 0 58%, #0c0c0a 60%);
		border: 1px solid rgba(204, 255, 0, 0.55);
		box-shadow: 0 0 0 5px rgba(9, 9, 11, 0.9), 0 0 26px rgba(204, 255, 0, 0.35);
		cursor: pointer;
		transition: background 0.5s, box-shadow 0.5s, transform 0.6s var(--ease-elastic);
	}

	.sg-node-n {
		position: relative;
		font: 500 max(10px, 1.15cqh) / 1 var(--ff-mono);
		letter-spacing: 0.08em;
		color: var(--acid);
		transition: color 0.4s;
	}

	.sg-node .radar-ring {
		border-color: rgba(204, 255, 0, 0.7);
		opacity: 0;
		animation-play-state: paused;
	}

	.sg-film.is-active .sg-node {
		background: var(--acid);
		transform: scale(1.18);
		box-shadow: 0 0 0 5px rgba(9, 9, 11, 0.9), 0 0 40px rgba(204, 255, 0, 0.8), 0 0 90px rgba(204, 255, 0, 0.35);
	}

	.sg-film.is-active .sg-node-n {
		color: var(--ink);
	}

	.sg-film.is-active .sg-node .radar-ring {
		opacity: 1;
		animation-play-state: running;
	}

	/* Linha de circuito: do nó até o pôster, com o "tique" horizontal */
	.sg-leader {
		position: absolute;
		left: 0;
		width: 1px;
		height: 7cqh;
		background: linear-gradient(var(--dir, to top), rgba(204, 255, 0, 0.9), rgba(204, 255, 0, 0.15));
	}

	.sg-leader::after {
		content: '';
		position: absolute;
		left: 0;
		width: 3cqh;
		height: 1px;
		background: rgba(204, 255, 0, 0.5);
	}

	.sg-film--up .sg-leader {
		bottom: 2.7cqh;
	}

	.sg-film--up .sg-leader::after {
		top: 0;
	}

	.sg-film--down .sg-leader {
		--dir: to bottom;
		top: 2.7cqh;
	}

	.sg-film--down .sg-leader::after {
		bottom: 0;
	}

	.sg-card {
		position: absolute;
		left: 0;
		width: 19cqh;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		translate: -50% 0;
		perspective: 1200px;
		transform: scale(0.8);
		filter: grayscale(0.9) brightness(0.6);
		transition: transform 0.9s var(--ease-out), filter 0.7s var(--ease-out);
	}

	.sg-film--up .sg-card {
		bottom: 9.6cqh;
		transform-origin: 50% 100%;
	}

	.sg-film--down .sg-card {
		top: 9.6cqh;
		transform-origin: 50% 0%;
	}

	.sg-film.is-active .sg-card,
	.sg-card:hover {
		transform: scale(1);
		filter: none;
	}

	.sg-card:focus-visible {
		outline: none;
	}

	.sg-card:focus-visible .sg-poster {
		outline: 2px solid var(--acid);
		outline-offset: 4px;
	}

	/* .poster + .tilt-card do design system */
	.sg-poster {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4.25;
		border-radius: 12px;
		overflow: hidden;
		background: #111;
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.1);
		transition: transform 0.5s var(--ease-out), box-shadow 0.6s;
		will-change: transform;
	}

	.sg-film.is-active .sg-poster {
		box-shadow: 0 0 0 1px rgba(204, 255, 0, 0.5), 0 0 60px -10px rgba(204, 255, 0, 0.45), 0 30px 60px -20px rgba(0, 0, 0, 0.7);
	}

	.sg-poster img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 1.2s var(--ease-out);
	}

	.sg-poster::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.3) 45%, transparent 60%);
		transform: translateX(-120%);
		transition: transform 1s var(--ease-out);
		pointer-events: none;
	}

	.sg-card:hover .sg-poster::after {
		transform: translateX(120%);
	}

	.sg-card:hover .sg-poster img {
		transform: scale(1.05);
	}

	/* Rótulo ao lado do pôster (como "STAGE 01" da referência 1) */
	.sg-meta {
		position: absolute;
		left: calc(100% + 2.4cqh);
		width: 30cqh;
		display: grid;
		gap: 0.9cqh;
		opacity: 0.45;
		transition: opacity 0.6s;
	}

	.sg-film--up .sg-meta {
		bottom: 0;
	}

	.sg-film--down .sg-meta {
		top: 0;
	}

	.sg-film.is-active .sg-meta {
		opacity: 1;
	}

	/* Em telas estreitas o rótulo seria cortado na borda; o título já aparece no texto à esquerda */
	@media (max-width: 1200px) {
		.sg-meta {
			display: none;
		}
	}

	.sg-meta-cap {
		font: 500 max(9px, 1.05cqh) / 1 var(--ff-mono);
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--acid);
	}

	.sg-meta-title {
		font: 900 max(1.1rem, 3.3cqh) / 0.9 var(--ff-display);
		text-transform: uppercase;
	}

	.sg-meta-year {
		font: 400 max(0.85rem, 1.6cqh) / 1 var(--ff-body);
		color: rgba(255, 255, 255, 0.65);
	}

	/* Ano-fantasma gigante do lado oposto (como os "Q1/Q2" da referência 1) */
	.sg-year {
		position: absolute;
		left: 0;
		translate: -50% 0;
		font: 900 21cqh / 0.8 var(--ff-display);
		white-space: nowrap;
		color: transparent;
		-webkit-text-stroke: 1px rgba(245, 245, 240, 0.14);
		pointer-events: none;
		transition: -webkit-text-stroke-color 0.8s;
	}

	.sg-film--up .sg-year {
		top: 7cqh;
	}

	.sg-film--down .sg-year {
		bottom: 7cqh;
	}

	.sg-film.is-active .sg-year {
		-webkit-text-stroke-color: rgba(204, 255, 0, 0.32);
	}

	/* Texto do filme ativo */
	/* Vidro do design system (glass): desfoca o fio por trás para facilitar a leitura */
	.saga-copy {
		--pad: clamp(20px, 2.2vw, 34px);
		position: absolute;
		z-index: 5;
		left: calc(var(--gutter) - var(--pad));
		top: 50%;
		translate: 0 -50%;
		width: calc(min(36vw, 560px) + var(--pad) * 2);
		padding: var(--pad);
		border-radius: clamp(18px, 1.8vw, 26px);
		background: rgba(9, 9, 11, 0.42);
		border: 1px solid rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(18px) saturate(1.1);
	}

	.saga-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin: 0;
		font: 500 clamp(10px, 0.85vw, 12px) / 1 var(--ff-mono);
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.78);
	}

	.saga-eyebrow-sep {
		width: 24px;
		height: 1px;
		background: rgba(255, 255, 255, 0.35);
	}

	.pulse-dot {
		position: relative;
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--acid);
		color: var(--acid);
	}

	.pulse-dot::after {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 999px;
		border: 1px solid currentColor;
		animation: radar 2s var(--ease-out) infinite;
	}

	.saga-title {
		margin: clamp(18px, 2.2vw, 28px) 0 0;
		font: 900 clamp(2.8rem, 6.2vw, 7.4rem) / 0.86 var(--ff-display);
		text-transform: uppercase;
		letter-spacing: -0.005em;
		transition: opacity 0.3s ease, filter 0.3s ease;
	}

	/* Títulos longos (ex.: Capitão América: O Primeiro Vingador) encolhem para caber com a sinopse */
	.saga-title.is-long {
		font-size: clamp(2.2rem, 4.1vw, 4.9rem);
	}

	.saga-title .t-line {
		display: block;
		overflow: hidden;
		/* acentos em cima, cedilha (Ç) embaixo */
		padding: 0.16em 0.03em 0.27em;
		margin: -0.16em 0 -0.24em;
	}

	.saga-title .t-word {
		display: inline-block;
		white-space: nowrap;
	}

	.saga-title .t-ch {
		display: inline-block;
		padding-bottom: 0.26em;
		margin-bottom: -0.26em;
		transform: translateY(110%);
		opacity: 0;
	}

	/* Nome do filme: branco que se dissolve */
	.saga-title .t-line--fill .t-ch {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0.2) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.saga.is-in .saga-title .t-ch {
		animation: textSlide 0.9s var(--ease-out) calc(0.15s + var(--i) * 32ms) forwards;
	}

	.saga-synopsis {
		margin: clamp(22px, 2.6vw, 34px) 0 0;
		max-width: 50ch;
		font: 400 clamp(0.95rem, 1.04vw, 1.06rem) / 1.65 var(--ff-body);
		color: rgba(255, 255, 255, 0.74);
	}

	.saga-synopsis[hidden] {
		display: none;
	}

	/* Troca de filme: texto sai com desfoque antes do novo entrar */
	.saga-copy.is-swapping .saga-title {
		opacity: 0;
		filter: blur(6px);
	}

	.saga-copy .saga-synopsis,
	.saga-copy [data-saga-chapter] {
		transition: opacity 0.4s ease, filter 0.4s ease;
	}

	.saga-copy.is-swapping .saga-synopsis,
	.saga-copy.is-swapping [data-saga-chapter] {
		opacity: 0;
		filter: blur(8px);
	}

	/* HUD do fio */
	.sg-hud {
		position: absolute;
		z-index: 6;
		top: clamp(24px, 5vh, 48px);
		right: var(--gutter);
		display: grid;
		justify-items: end;
		gap: 10px;
		font: 500 10px/1 var(--ff-mono);
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.55);
	}

	.sg-hud-row {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.sg-hud b {
		font-weight: 500;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}

	.sg-hud-dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--ember);
		box-shadow: 0 0 10px var(--ember);
		animation: sgBreathe 1.2s ease-in-out infinite alternate;
	}

	@media (max-width: 900px) {
		.saga-card {
			display: flex;
			flex-direction: column;
			gap: 20px;
			padding: 72px var(--gutter) 28px;
		}

		.saga-copy {
			position: relative;
			left: auto;
			right: auto;
			top: auto;
			bottom: auto;
			width: auto;
			translate: none;
		}

		.sg-stage {
			position: relative;
			inset: auto;
			flex: 1 1 0;
			min-height: 0;
			margin-inline: calc(var(--gutter) * -1);
			-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
			mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
		}

		.sg-card {
			width: 27cqh;
		}

		.sg-meta,
		.sg-hud {
			display: none;
		}

		.sg-year {
			font-size: 17cqh;
		}

		.saga-title {
			font-size: clamp(2.4rem, 12vw, 3.6rem);
		}

		.saga-synopsis {
			display: -webkit-box;
			-webkit-line-clamp: 4;
			-webkit-box-orient: vertical;
			overflow: hidden;
			font-size: 0.9rem;
			margin-top: 16px;
		}

		.saga-shade {
			background: linear-gradient(to bottom, rgba(9, 9, 11, 0.9) 0%, rgba(9, 9, 11, 0.55) 45%, rgba(9, 9, 11, 0.8) 100%);
		}
	}

	/* =========================================================
	   TERCEIRA DOBRA · A CONVERGÊNCIA (TRAILER)
	   --draw: fios desenhados · --c: palavra engolida · --o: fenda aberta (JS)
	   ========================================================= */
	.doom {
		position: relative;
		height: 320svh;
		background: var(--obsidian);
	}

	.doom-sticky {
		position: sticky;
		top: 0;
		height: 100svh;
		padding: var(--frame);
	}

	.doom-card {
		position: relative;
		height: calc(100svh - var(--frame) * 2);
		min-height: 560px;
		border-radius: var(--radius);
		overflow: hidden;
		isolation: isolate;
		background: radial-gradient(70% 70% at 50% 50%, #101009 0%, #060607 75%);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 40px 120px -40px rgba(204, 255, 0, 0.12);
	}

	/* Tremor do quadro no instante em que a fenda rasga */
	.doom.is-rift .doom-card {
		animation: doomQuake 0.55s steps(2) 1;
	}

	@keyframes doomQuake {
		0% { translate: 0 0; }
		20% { translate: -3px 2px; }
		40% { translate: 3px -2px; }
		60% { translate: -2px -1px; }
		80% { translate: 2px 1px; }
		100% { translate: 0 0; }
	}

	.doom-vignette {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: radial-gradient(60% 60% at 50% 50%, transparent 40%, rgba(6, 6, 7, 0.9) 100%);
	}

	/* Ambilight: a luz do trailer vaza para o quadro */
	.doom-ambi {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: grid;
		place-items: center;
		opacity: calc(var(--o, 0) * 0.55);
		pointer-events: none;
	}

	.doom-ambi img {
		width: 70%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		filter: blur(70px) saturate(1.6);
		transform: scale(calc(0.6 + var(--o, 0) * 0.7));
	}

	.doom.is-playing .doom-ambi {
		opacity: 0.75;
		animation: sgBreathe 2.2s ease-in-out infinite alternate;
	}

	/* Fios em espiral */
	.doom-rays {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: calc(1 - var(--o, 0));
	}

	.doom-rays path {
		fill: none;
		vector-effect: non-scaling-stroke;
		stroke-linecap: round;
	}

	.doom-ray-line {
		stroke: var(--bone);
		stroke-width: 1.1;
		opacity: 0.55;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	.doom-ray:nth-child(3n) .doom-ray-line {
		stroke: var(--ember);
		opacity: 0.8;
	}

	.doom-ray:nth-child(4n + 1) .doom-ray-line {
		stroke: var(--acid);
		opacity: 0.7;
	}

	/* Faíscas viajando pelos fios até o centro */
	.doom-ray-spark {
		stroke: #fff;
		stroke-width: 2.4;
		stroke-dasharray: 0.03 0.97;
		stroke-dashoffset: 0.03;
		opacity: var(--draw, 0);
		filter: drop-shadow(0 0 4px rgba(204, 255, 0, 0.9));
		animation: doomSpark 2.6s cubic-bezier(0.55, 0, 0.9, 0.4) infinite;
	}

	.doom-ray:nth-child(2n) .doom-ray-spark {
		animation-delay: -1.3s;
	}

	.doom-ray:nth-child(3n) .doom-ray-spark {
		animation-delay: -0.7s;
	}

	@keyframes doomSpark {
		to { stroke-dashoffset: -0.97; }
	}

	/* Anos na ponta de cada fio */
	.doom-years {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		opacity: calc(var(--draw, 0) * (1 - var(--c, 0)));
	}

	.doom-year {
		position: absolute;
		translate: -50% -50%;
		padding: 4px 7px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: rgba(9, 9, 11, 0.75);
		font: 500 9px/1 var(--ff-mono);
		letter-spacing: 0.2em;
		color: rgba(255, 255, 255, 0.7);
	}

	/* Singularidade */
	.doom-core {
		position: absolute;
		z-index: 5;
		left: 50%;
		top: 50%;
		width: 12px;
		height: 12px;
		translate: -50% -50%;
		border-radius: 999px;
		background: #fff;
		box-shadow: 0 0 12px #fff, 0 0 30px var(--acid), 0 0 70px rgba(204, 255, 0, 0.6), 0 0 140px rgba(255, 51, 0, 0.45);
		scale: calc(0.4 + var(--draw, 0) * 0.6 + var(--c, 0) * 1.6);
		opacity: calc(var(--draw, 0) * (1 - var(--o, 0) * 3));
	}

	.doom-core .radar-ring {
		inset: -10px;
		border-color: rgba(204, 255, 0, 0.6);
	}

	/* A fenda e a tela */
	.doom-rift,
	.doom-screen {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
	}

	.doom-rift {
		z-index: 6;
		width: var(--rw, 0px);
		height: var(--rh, 0px);
		border-radius: var(--rr, 999px);
		pointer-events: none;
		box-shadow:
			0 0 0 1px rgba(204, 255, 0, 0.9),
			0 0 18px 2px rgba(204, 255, 0, 0.75),
			0 0 60px 6px rgba(255, 51, 0, 0.55),
			0 0 140px 20px rgba(255, 51, 0, 0.25);
		opacity: min(1, calc(var(--o, 0) * 40));
	}

	.doom-screen {
		z-index: 7;
		width: min(82%, calc((100svh - var(--frame) * 2) * 0.66 * 16 / 9));
		aspect-ratio: 16 / 9;
		clip-path: inset(50% 50% round 999px);
		border-radius: 18px;
	}

	.doom-media {
		position: absolute;
		inset: 0;
		border-radius: 18px;
		overflow: hidden;
		background: #000;
	}

	.doom-thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		scale: calc(1.35 - var(--o, 0) * 0.35);
		filter: saturate(0.9) contrast(1.08);
	}

	.doom-shade {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(60% 60% at 50% 50%, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.6)),
			linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent 40%);
		pointer-events: none;
	}

	.doom-media iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* Botão: .beam-pill do design system */
	.beam-pill {
		position: relative;
		display: inline-flex;
		border-radius: 9999px;
		padding: 1px;
		overflow: hidden;
		isolation: isolate;
		border: 0;
		background: none;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}

	.beam-pill .beam-spin {
		position: absolute;
		inset: -1000%;
		background: conic-gradient(from 0deg, transparent 0 300deg, #ccff00 340deg, #ffffff 360deg);
		animation: spin 2.4s linear infinite;
		z-index: -1;
	}

	.beam-pill .beam-inner {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-radius: 9999px;
		background: #1c1c1c;
		color: #fff;
		padding: 1rem 1.75rem 1rem 1.5rem;
		overflow: hidden;
	}

	.beam-pill .beam-inner .shine {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
		transform: translateX(-100%) skewX(-15deg);
		opacity: 0;
	}

	.beam-pill:hover .beam-inner .shine {
		animation: shimmer 1.5s infinite;
		opacity: 1;
	}

	.beam-pill .halo {
		position: absolute;
		inset: -8px;
		border-radius: 9999px;
		background: rgba(204, 255, 0, 0.45);
		filter: blur(18px);
		opacity: 0;
		transition: opacity 0.5s;
		z-index: -2;
	}

	.beam-pill:hover .halo,
	.beam-pill:focus-visible .halo {
		opacity: 1;
	}

	.beam-pill:focus-visible {
		outline: 2px solid var(--acid);
		outline-offset: 4px;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	@keyframes shimmer {
		from { transform: translateX(-100%) skewX(-15deg); }
		to { transform: translateX(200%) skewX(-15deg); }
	}

	.doom-play {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		opacity: 0;
		scale: 0.9;
		pointer-events: none;
		transition: opacity 0.6s var(--ease-out), scale 0.6s var(--ease-elastic);
	}

	.doom.is-open .doom-play {
		opacity: 1;
		scale: 1;
		pointer-events: auto;
	}

	.doom-play-icon {
		width: 18px;
		height: 18px;
		fill: var(--acid);
	}

	.doom-play-label {
		position: relative;
		font: 500 0.85rem/1 var(--ff-body);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	/* Cantos de mira em volta da tela */
	.doom-corner {
		position: absolute;
		width: 22px;
		height: 22px;
		border: 0 solid var(--acid);
		opacity: 0;
		transition: opacity 0.6s, translate 0.8s var(--ease-out);
	}

	.doom-corner--tl { left: -14px; top: -14px; border-width: 2px 0 0 2px; translate: -10px -10px; }
