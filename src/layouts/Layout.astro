---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
// Imagem padrão da marca para compartilhamento (usada quando a página não envia `image`)
import defaultShareImage from '../assets/poster-vingadores/doomsday-card-1200.webp';

interface Props {
	/** Obrigatório: cada página tem o seu título (aparece na aba, no Google e nos cards). */
	title: string;
	/** Obrigatório: cada página tem a sua descrição (~150 caracteres). Nunca repetir entre páginas. */
	description: string;
	/** Imagem de compartilhamento: um asset importado ou um caminho/URL (ex.: '/og.jpg'). Opcional. */
	image?: ImageMetadata | string;
	/** Texto alternativo da imagem de compartilhamento. */
	imageAlt?: string;
}

// Sem valores padrão para título e descrição: uma página que esquecer de enviar os seus
// gera erro de tipo, em vez de herdar em silêncio o texto de outra página.
const {
	title,
	description,
	image = defaultShareImage,
	imageAlt = 'Pôster de Vingadores: Doomsday',
} = Astro.props;

// Redes sociais só leem URL absoluta: o caminho relativo (/_astro/...) quebra o card.
// Astro.site vem de `site` no astro.config; sem ele, cai no endereço da requisição (Astro.url).
const base = Astro.site ?? Astro.url;
const imageSrc = typeof image === 'string' ? image : image.src;
const imageURL = new URL(imageSrc, base).href;
const pageURL = new URL(Astro.url.pathname, base).href;
const imageSize = typeof image === 'string' ? null : { width: image.width, height: image.height };
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Vingadores Doomsday" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:alt" content={imageAlt} />
		{imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
		{imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}

		<!-- Twitter / X Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
